# Copy this file to .env and fill in the provider credentials.
# Do not commit .env.

# AI provider (Alibaba DashScope OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local Mailpit SMTP (use a real SMTP host and credentials outside local development)
COGNIGO_EMAIL=
COGNIGO_EMAIL_AUTHCODE=
COGNIGO_SMTP_HOST=localhost
COGNIGO_SMTP_PORT=1025

# Baidu TTS
COGNIGO_BAIDU_API_KEY=
COGNIGO_BAIDU_SECRET_KEY=

# Application
COGNIGO_APP_NAME=CogniGo
COGNIGO_HOST=0.0.0.0
COGNIGO_PORT=9090
COGNIGO_API_URL=http://localhost:9090
COGNIGO_JWT_KEY=replace-with-a-long-random-value
COGNIGO_JWT_EXPIRE_HOURS=8760
COGNIGO_JWT_ISSUER=huanheart
COGNIGO_JWT_SUBJECT=CogniGo
# 32-byte key (raw or base64) used to encrypt user provider API keys.
COGNIGO_PROVIDER_ENCRYPTION_KEY=01234567890123456789012345678901

# Runtime paths
COGNIGO_UPLOAD_DIR=./uploads
COGNIGO_ONNX_LIBRARY_PATH=./.local/onnxruntime/lib/libonnxruntime.so.1.22.0
COGNIGO_ONNX_MODEL_PATH=./models/mobilenetv2/mobilenetv2-7.onnx
COGNIGO_LABELS_PATH=./imagenet_classes.txt
COGNIGO_MCP_URL=http://127.0.0.1:8081/mcp
COGNIGO_MCP_MAX_STEPS=12

# RAG
COGNIGO_EMBEDDING_MODEL=text-embedding-v4
COGNIGO_RAG_CHAT_MODEL=qwen-turbo
COGNIGO_RAG_DOC_DIR=./docs
COGNIGO_RAG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COGNIGO_RAG_CHUNK_SIZE=1000
COGNIGO_RAG_CHUNK_OVERLAP=150
COGNIGO_RAG_TOP_K=5
COGNIGO_RAG_DISTANCE_THRESHOLD=0.45
COGNIGO_RAG_USE_DISTANCE_THRESHOLD=true

# Infrastructure (local Compose defaults)
COGNIGO_MYSQL_HOST=127.0.0.1
COGNIGO_MYSQL_PORT=3306
COGNIGO_MYSQL_USER=root
COGNIGO_MYSQL_PASSWORD=change-me
COGNIGO_MYSQL_DATABASE=CogniGo
COGNIGO_MYSQL_CHARSET=utf8mb4
COGNIGO_REDIS_HOST=127.0.0.1
COGNIGO_REDIS_PORT=6379
COGNIGO_REDIS_PASSWORD=
COGNIGO_REDIS_DB=0
COGNIGO_RABBITMQ_HOST=127.0.0.1
COGNIGO_RABBITMQ_PORT=5672
COGNIGO_RABBITMQ_USER=root
COGNIGO_RABBITMQ_PASSWORD=change-me
COGNIGO_RABBITMQ_VHOST=/
COGNIGO_RABBITMQ_MANAGEMENT_PORT=15672
